# Copy to infra/.env and adjust if needed.

# OpenStreetMap extract used by routing (Valhalla) and search (Nominatim).
OSM_PBF_URL=https://download.geofabrik.de/asia/sri-lanka-latest.osm.pbf

# Port the gateway listens on. The app talks only to this port.
GATEWAY_PORT=8080

# Threads used to build/serve the routing graph and run the search import.
VALHALLA_THREADS=2
NOMINATIM_THREADS=4

# Change before exposing the stack beyond your machine.
NOMINATIM_PASSWORD=change-me
